# How to use: copy this file to .env ... fill in ONE provider ...
# No key at all? The app still runs: saved AI answers in llm_cache.json are reused.

# Option A: Groq, free tier (used for the reported AI results)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
HESAB_OPENAI_MODEL=openai/gpt-oss-120b

# Option B: Google Gemini, free tier
GEMINI_API_KEY=

# Option C: Anthropic Claude, paid
ANTHROPIC_API_KEY=

# Optional quota protection
HESAB_LLM_BATCH=5
HESAB_MAX_LLM_CALLS=100